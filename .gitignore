__pycache__/
*.py[cod]
*$py.class
.DS_Store
*.tmp
*.log

# Project data, drawings, accepted native exports, generated macros and reports
# are versioned.  The repository owner explicitly selected a complete-project
# archive on 2026-07-30 so future revisions can reconcile against exact accepted
# baselines instead of regenerating over manual E3D edits.

# Microsoft Office lock files are transient and can contain workstation/user
# metadata.  The actual workbook remains versioned.
~$*

# E3D system information reports written on a crash
errors/

# Local environments
.venv/
venv/
.env

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Experimental E3D live bridge build and launch artifacts
integrations/e3d_live/addin/bin/
integrations/e3d_live/deployment/runtime/
