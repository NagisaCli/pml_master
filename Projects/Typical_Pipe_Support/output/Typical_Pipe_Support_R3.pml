-- Typical Pipe Support R3: complete independent geometry review.
-- Start from a writable SITE. No DELETE, external model lookup or SAVEWORK.
-- All new connection and fastener detail dimensions are Reference Values.
-- R2 screenshot is the unedited working baseline; original steel catalogue retained.
NEW ZONE /ZONE_TYPICAL_SUPPORT_R3
ORI Y IS N AND Z IS U
POS E 0 N 0 U 0
NEW STRU /TPS_R3_STRUCTURE
ORI Y IS N AND Z IS U
POS E 0 N 0 U 0
NEW FRMW /TPS_R3_FRAME
NEW SCTN /TPS_R3_BEAM
POSS E 0.0 N 16.0 U 0.0
POSE E 0.0 N 1500.0 U 0.0
DRNS PERP
DRNE PERP
JUSL CTOP
SPRE SPCOMPONENT /BS-PFC150x75x18
END
NEW SCTN /TPS_R3_BRACE
POSS E 0 N 80 U -452.444658
POSE E 0 N 1080 U -178.142445
DRNS PERP
DRNE PERP
JUSL TOAY
SPRE SPCOMPONENT /BS-L50x50x6
END
END
END
/ZONE_TYPICAL_SUPPORT_R3
NEW EQUI /TPS_R3_HARDWARE
POS E 0.0 N 0.0 U 0.0
NEW SUBE /TPS_R3_MOUNTING_PLATES
ORI Y IS N AND Z IS U
POS E 0 N 0 U 0
-- UPPER_MOUNT_PLATE Reference Value: 6 mm clipped corners; source envelope
NEW EXTRUSION
POS E 0.0 N 0.0 U -75.0
ORI Y IS U AND Z IS N
LEVE 5 10
HEIG 16.0

NEW LOOP
NEW VERTEX
POS E -90.000000 N -169.000000 U 0
END
NEW VERTEX
POS E -90.000000 N 169.000000 U 0
END
NEW VERTEX
