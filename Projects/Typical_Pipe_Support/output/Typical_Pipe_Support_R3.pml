END
NEW VERTEX
POS E -84.000000 N -175.000000 U 0
END
END
NEW NCYLINDER
DIAM 22.000000
HEIG 20.000000
ORI Y IS N AND Z IS U
POS E 45.000000 N 135.000000 U 8.000000
NAPPFLAG 2
END
NEW NCYLINDER
DIAM 22.000000
HEIG 20.000000
ORI Y IS N AND Z IS U
POS E -45.000000 N 135.000000 U 8.000000
NAPPFLAG 2
END
NEW NCYLINDER
