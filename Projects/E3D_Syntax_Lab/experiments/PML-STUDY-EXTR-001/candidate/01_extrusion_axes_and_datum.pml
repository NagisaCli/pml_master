$S-  -- Synonym translation OFF
ONERROR GOLABEL /ERROR3
INPUT BEGIN
NEW EQUIPMENT /CODEX_EXTR_AXES
POS E 0mm N 0mm U 0mm
DESC 'EXTRUSION LOCAL XY AND Z AXIS TEST'
NEW SUBEQUIPMENT /CODEX_EXTR_AXES_U
NEW EXTRUSION
POS E 0mm N 0mm U 1000mm
ORI Y IS N AND Z IS U
LEVE 5 10
HEIG 800mm

NEW LOOP
NEW VERTEX
POS E 0mm N 0mm U 0mm
END
NEW VERTEX
POS E 0mm N 300mm U 0mm
END
NEW VERTEX
POS E 100mm N 300mm U 0mm
END
NEW VERTEX
POS E 100mm N 100mm U 0mm
END
NEW VERTEX
POS E 300mm N 100mm U 0mm
END
NEW VERTEX
POS E 300mm N 0mm U 0mm
END
END
END
END
NEW SUBEQUIPMENT /CODEX_EXTR_AXES_E
NEW EXTRUSION
POS E 2000mm N 0mm U 1000mm
ORI Y IS N AND Z IS E
LEVE 5 10
HEIG 800mm

NEW LOOP
NEW VERTEX
POS E 0mm N 0mm U 0mm
END
NEW VERTEX
POS E 0mm N 300mm U 0mm
END
NEW VERTEX
POS E 100mm N 300mm U 0mm
END
NEW VERTEX
POS E 100mm N 100mm U 0mm
END
NEW VERTEX
POS E 300mm N 100mm U 0mm
END
NEW VERTEX
POS E 300mm N 0mm U 0mm
END
END
END
END
NEW SUBEQUIPMENT /CODEX_EXTR_AXES_N
NEW EXTRUSION
POS E 4000mm N 0mm U 1000mm
ORI Y IS U AND Z IS N
LEVE 5 10
HEIG 800mm

NEW LOOP
NEW VERTEX
POS E 0mm N 0mm U 0mm
END
NEW VERTEX
POS E 0mm N 300mm U 0mm
END
NEW VERTEX
POS E 100mm N 300mm U 0mm
END
NEW VERTEX
POS E 100mm N 100mm U 0mm
END
NEW VERTEX
POS E 300mm N 100mm U 0mm
END
NEW VERTEX
POS E 300mm N 0mm U 0mm
END
END
END
END
END
INPUT END EQUIPMENT /CODEX_EXTR_AXES
INPUT FINISH
LABEL /ERROR3
handle ANY
$S+
RETURN ERROR
endhandle
$S+  -- Synonym translation ON
