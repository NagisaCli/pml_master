$S-  -- Synonym translation OFF
ONERROR GOLABEL /ERROR3
INPUT BEGIN
NEW EQUIPMENT /CODEX_EXTR_ORDER
POS E 0mm N 0mm U 0mm
DESC 'EXTRUSION POS/ORI ASSIGNMENT ORDER SENSITIVITY TEST'
NEW SUBEQUIPMENT /CODEX_EXTR_ORDER_A
NEW EXTRUSION
POS E 0mm N 0mm U 1000mm
ORI Y IS N AND Z IS E
