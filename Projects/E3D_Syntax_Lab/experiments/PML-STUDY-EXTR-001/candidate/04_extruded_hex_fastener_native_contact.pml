$S-  -- Synonym translation OFF
ONERROR GOLABEL /ERROR3
INPUT BEGIN
NEW EQUIPMENT /CODEX_EXTR_FASTENER_NATIVE
POS E 0mm N 0mm U 0mm
DESC 'EXTRUDED HEX FASTENER NATIVE CONTACT CONTRACT'
NEW SUBEQUIPMENT /CODEX_EXTR_FASTENER_ASSEMBLY
NEW CYLINDER
DIAM 15mm
HEIG 100mm
ORI Z IS U AND Y IS N
POS E 0mm N 0mm U 60mm
END
NEW EXTRUSION
POS E 0mm N 0mm U 20mm
ORI Y IS N AND Z IS U
LEVE 5 10
HEIG 20mm

NEW LOOP
NEW VERTEX
POS E -20mm N 0mm U 0mm
END
NEW VERTEX
POS E -10mm N 17.320508mm U 0mm
END
NEW VERTEX
POS E 10mm N 17.320508mm U 0mm
END
NEW VERTEX
POS E 20mm N 0mm U 0mm
END
NEW VERTEX
POS E 10mm N -17.320508mm U 0mm
END
NEW VERTEX
POS E -10mm N -17.320508mm U 0mm
END
END
END
NEW EXTRUSION
POS E 0mm N 0mm U 90mm
ORI Y IS N AND Z IS U
LEVE 5 10
HEIG 20mm

NEW LOOP
NEW VERTEX
POS E -20mm N 0mm U 0mm
END
NEW VERTEX
POS E -10mm N 17.320508mm U 0mm
END
NEW VERTEX
POS E 10mm N 17.320508mm U 0mm
END
NEW VERTEX
POS E 20mm N 0mm U 0mm
END
NEW VERTEX
POS E 10mm N -17.320508mm U 0mm
END
NEW VERTEX
POS E -10mm N -17.320508mm U 0mm
END
END
END
END
END
INPUT END EQUIPMENT /CODEX_EXTR_FASTENER_NATIVE
INPUT FINISH
LABEL /ERROR3
handle ANY
$S+
RETURN ERROR
endhandle
