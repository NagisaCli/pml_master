$S-  -- Synonym translation OFF
-- PML-STUDY-PIPE-001 / candidate 11
-- EXPERIMENTAL high-density all-component stress test
-- 16 PIPE / 16 BRANCH / 180 catalogue component blocks
ONERROR GOLABEL /ERROR3

INPUT BEGIN
NEW SITE /CODEX-PIPE-LAB11
PURP PIPE

NEW ZONE /CODEX-PIPE-LAB11-ZONE
DESC 'HIGH DENSITY ALL COMPONENT STRESS TEST'
FUNC 'Piping'
PURP PIPE

NEW PIPE /CODEX-P11-01-DENSE
BORE 100mm
TEMP 50degC
PRES 0pascal
TPRESS 0pascal
PSPE SPECIFICATION /A3B
NEW BRANCH /CODEX-P11-01-DENSE/B1
HPOS E 0mm N 0mm U 0mm
TPOS E 16000mm N 0mm U 0mm
HDIR E
TDIR W
LHEA true
LTAI true
HBOR 100mm
TBOR 100mm
HCON OPEN
TCON OPEN
TEMP 50degC
PRES 0pascal
TPRESS 0pascal
HSTU SPCOMPONENT /A3B/PA100
PSPE SPECIFICATION /A3B
NEW FLANGE
POS E 800mm N 0mm U 0mm
ORI Y IS W AND Z IS U
BUIL false
SHOP true
SPRE SPCOMPONENT /A3B/FO100
LSTU SPCOMPONENT /A3B/PA100
ARRI 2
LEAV 1
RLOC 2
ORIF true
POSF true
END
NEW GASKET
POS E 1050mm N 0mm U 0mm
ORI Y IS E AND Z IS U
BUIL false
SHOP true
SPRE SPCOMPONENT /A3B/GC100
LSTU SPCOMPONENT /A3B/PA100
RLOC 2
ORIF true
POSF true
END
NEW VALVE /CODEX-P11-V01
POS E 1400mm N 0mm U 0mm
ORI Y IS E AND Z IS N
BUIL false
SHOP true
SPRE SPCOMPONENT /A3B/VG100
LSTU SPCOMPONENT /A3B/PA100
ORIF true
POSF true
END
NEW INSTRUMENT /CODEX-P11-I01
POS E 1800mm N 0mm U 0mm
ORI Y IS W AND Z IS U
BUIL false
SHOP true
SPRE SPCOMPONENT /A3B/OP100
LSTU SPCOMPONENT /A3B/PA100
ARRI 2
LEAV 1
ORIF true
POSF true
END
NEW ELBOW
POS E 3200mm N 0mm U 0mm
ORI Y IS D AND Z IS N
BUIL false
SHOP true
SPRE SPCOMPONENT /A3B/EA100
LSTU SPCOMPONENT /A3B/PA100
ARRI 2
LEAV 1
ORIF true
POSF true
END
NEW TEE
POS E 5000mm N 0mm U 0mm
ORI Y IS N AND Z IS D
BUIL false
SHOP true
SPRE SPCOMPONENT /A3B/ST:100_100
LSTU SPCOMPONENT /A3B/PA100
ARRI 3
ORIF true
POSF true
END
NEW REDUCER
POS E 6800mm N 0mm U 0mm
ORI Y IS E AND Z IS U
BUIL false
SHOP true
SPRE SPCOMPONENT /A3B/RC100X80
LSTU SPCOMPONENT /A3B/PA80
ORIF true
POSF true
END
NEW OLET
POS E 8000mm N 0mm U 0mm
ORI Y IS E AND Z IS N
BUIL false
SHOP true
SPRE SPCOMPONENT /A3B/TOL:100_80
LSTU SPCOMPONENT /A3B/PA100
ARRI 2
LEAV 1
ORIF true
POSF true
END
NEW COUPLING
POS E 9200mm N 0mm U 0mm
ORI Y IS N AND Z IS W
BUIL false
SHOP true
SPRE SPCOMPONENT /A3B/HC5:25
LSTU SPCOMPONENT /A3B/PA25
ORIF true
POSF true
END
NEW BEND
POS E 10500mm N 0mm U 0mm
ORI Y IS U AND Z IS E
BUIL false
SHOP true
SPRE SPCOMPONENT /A3B/EV50
LSTU SPCOMPONENT /A3B/PA50
RADI 152.4mm
ANGL 90degree
ORIF true
POSF true
END
NEW FILTER
POS E 12200mm N 0mm U 0mm
ORI Y IS W AND Z IS U
BUIL false
SHOP true
SPRE SPCOMPONENT /A3B/FIB100
LSTU SPCOMPONENT /A3B/PA100
ORIF true
POSF true
END
NEW CLOSURE
POS E 14500mm N 0mm U 0mm
ORI Y IS N AND Z IS E
BUIL false
SHOP true
SPRE SPCOMPONENT /A3B/KM20
LSTU SPCOMPONENT /A3B/PA20
ORIF true
POSF true
END
NEW WELD
POS E 5600mm N 0mm U 0mm
ORI Y IS W AND Z IS U
BUIL false
SHOP true
SPRE SPCOMPONENT /A3B/100WELFFWW
LSTU SPCOMPONENT /A3B/PA100
DESP 0
WLDN 1
ORIF true
POSF true
END
END
END

