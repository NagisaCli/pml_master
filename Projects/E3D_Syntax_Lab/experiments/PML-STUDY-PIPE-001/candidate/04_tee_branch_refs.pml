$S-  -- Synonym translation OFF
-- PML-STUDY-PIPE-001 / candidate 04
-- TEE P3 connection using the native two-pass CREF/TREF pattern.

ONERROR GOLABEL /ERROR3

INPUT BEGIN
NEW SITE /CODEX-PIPE-LAB04
PURP PIPE

NEW ZONE /CODEX-PIPE-LAB04-ZONE
DESC 'TEE BRANCH REFERENCE TEST'
FUNC 'Piping'
PURP PIPE

NEW PIPE /CODEX-P04-TEE
BORE 150mm
TEMP 50degC
PRES 0pascal
TPRESS 0pascal
PSPE SPECIFICATION /A1A
DELDSG FALS

NEW BRANCH /CODEX-P04-TEE/B1
HPOS E 0mm N 0mm U 2000mm
TPOS E 4000mm S 4000mm U 0mm
HDIR E
TDIR N
LHEA true
LTAI true
HBOR 150mm
TBOR 150mm
HCON OPEN
TCON OPEN
HSTU SPCOMPONENT /A1A/PA150
PSPE SPECIFICATION /A1A
DELDSG FALS

NEW ELBOW
POS E 4000mm N 0mm U 2000mm
ORI Y is D and Z is N
BUIL false
SHOP true
SPRE SPCOMPONENT /A1A/EA150
LSTU SPCOMPONENT /A1A/PA150
ORIF true
POSF true
DELDSG FALS

END
NEW TEE
POS E 4000mm N 0mm U 0mm
ORI Y is E and Z is U
BUIL false
SHOP true
SPRE SPCOMPONENT /A1A/TA150
LSTU SPCOMPONENT /A1A/PA150
ARRI 3
ORIF true
POSF true
DELDSG FALS
NOMDIR unset

END
END

NEW BRANCH /CODEX-P04-TEE/B2
HPOS E 4000mm N 3000mm U 0mm
TPOS E 4000mm N 142.87mm U 0mm
HDIR S
TDIR N
LHEA true
LTAI true
HBOR 150mm
TBOR 150mm
HCON OPEN
TCON BWD
HSTU SPCOMPONENT /A1A/PA150
PSPE SPECIFICATION /A1A
DELDSG FALS

END
END
END
END

-- Second pass: both referenced elements now exist.
OLD TEE 1 of BRANCH /CODEX-P04-TEE/B1
CREF BRANCH /CODEX-P04-TEE/B2 TAIL

OLD BRANCH /CODEX-P04-TEE/B2
TREF TEE 1 of BRANCH /CODEX-P04-TEE/B1

INPUT END SITE /CODEX-PIPE-LAB04
INPUT FINISH

LABEL /ERROR3
handle ANY
$S+
RETURN ERROR
endhandle

$S+  -- Synonym translation ON

