$S-  -- Synonym translation OFF
-- PML-STUDY-PIPE-001 / candidate 09
-- Crash isolation A: only verified straight and sloped free branches.

ONERROR GOLABEL /ERROR3

INPUT BEGIN
NEW SITE /CODEX-PIPE-LAB09
PURP PIPE

NEW ZONE /CODEX-PIPE-LAB09-ZONE
DESC 'PIPE CLUSTER CORE ISOLATION'
FUNC 'Piping'
PURP PIPE

NEW PIPE /CODEX-P09-01-HEADER
BORE 100mm
TEMP 50degC
PRES 0pascal
TPRESS 0pascal
PSPE SPECIFICATION /A3B
NEW BRANCH /CODEX-P09-01-HEADER/B1
HPOS E 0mm N 0mm U 0mm
TPOS E 12000mm N 0mm U 0mm
HDIR E
TDIR W
LHEA true
LTAI true
HBOR 100mm
TBOR 100mm
HCON OPEN
TCON OPEN
TEMP 50degC
PRES 0pascal
TPRESS 0pascal
HSTU SPCOMPONENT /A3B/PA100
PSPE SPECIFICATION /A3B
END
END

NEW PIPE /CODEX-P09-02-SLOPE
BORE 100mm
TEMP 50degC
PRES 0pascal
TPRESS 0pascal
PSPE SPECIFICATION /A1A
SLOREF SLOELE /1in100
NEW BRANCH /CODEX-P09-02-SLOPE/B1
HPOS E 0mm N 2500mm U 100mm
TPOS E 10000mm N 2500mm U 0mm
HDIR E 0.5729 D
TDIR W 0.5729 U
LHEA true
LTAI true
HBOR 100mm
TBOR 100mm
HCON OPEN
TCON OPEN
TEMP 50degC
PRES 0pascal
TPRESS 0pascal
HSTU SPCOMPONENT /A1A/PA100
PSPE SPECIFICATION /A1A
SLOREF SLOELE /1in100
END
END

END
END

INPUT END SITE /CODEX-PIPE-LAB09
INPUT FINISH

LABEL /ERROR3
handle ANY
$S+
RETURN ERROR
endhandle

$S+  -- Synonym translation ON
