$S-  -- Synonym translation OFF
-- PML-STUDY-PIPE-001 / candidate 01
-- Core hierarchy, automatic tube, elbow, valve train and reducer.

ONERROR GOLABEL /ERROR3

INPUT BEGIN
NEW SITE /CODEX-PIPE-LAB01
PURP PIPE

NEW ZONE /CODEX-PIPE-LAB01-ZONE
DESC 'CODEX PIPE CORE TEST'
FUNC 'Piping'
PURP PIPE

-- T01: straight automatic tube, 100 bore, E 0 to E 4000.
NEW PIPE /CODEX-P01-T01-STRAIGHT
BUIL false
SHOP false
BORE 100mm
TEMP 50degC
PRES 0pascal
TPRESS 0pascal
PSPE SPECIFICATION /A3B
CCEN 0
CCLA 0
LNTP unset
DUTY unset
DSCO unset
PTSP unset
INSC unset
DELDSG FALS
PLANU unset

NEW BRANCH /CODEX-P01-T01-STRAIGHT/B1
BUIL false
SHOP false
HPOS E 0mm N 0mm U 0mm
TPOS E 4000mm N 0mm U 0mm
HDIR E
TDIR W
LHEA true
LTAI true
HBOR 100mm
TBOR 100mm
HCON OPEN
TCON OPEN
TEMP 50degC
PRES 0pascal
TPRESS 0pascal
HSTU SPCOMPONENT /A3B/PA100
PSPE SPECIFICATION /A3B
DELDSG FALS

END
END

-- T02: one catalogue elbow; flow rises 2000 then turns West 4000.
NEW PIPE /CODEX-P01-T02-ELBOW
BUIL false
SHOP false
BORE 100mm
TEMP 50degC
PRES 0pascal
TPRESS 0pascal
PSPE SPECIFICATION /A3B
DELDSG FALS

NEW BRANCH /CODEX-P01-T02-ELBOW/B1
BUIL false
SHOP false
HPOS E 0mm N 5000mm U 0mm
TPOS W 4000mm N 5000mm U 2000mm
HDIR U
TDIR E
LHEA true
LTAI true
HBOR 100mm
TBOR 100mm
HCON OPEN
TCON OPEN
TEMP 50degC
PRES 0pascal
TPRESS 0pascal
HSTU SPCOMPONENT /A3B/PA100
PSPE SPECIFICATION /A3B
DELDSG FALS

NEW ELBOW
POS E 0mm N 5000mm U 2000mm
ORI Y is D and Z is N
BUIL false
SHOP true
SPRE SPCOMPONENT /A3B/EA100
LSTU SPCOMPONENT /A3B/PA100
ORIF true
POSF true
DELDSG FALS

END
END
END

-- T03: native 20 mm gasket/flange/valve sequence along South.
NEW PIPE /CODEX-P01-T03-VALVE
BUIL false
SHOP false
BORE 20mm
TEMP 50degC
PRES 0pascal
TPRESS 0pascal
PSPE SPECIFICATION /A3B
DELDSG FALS

NEW BRANCH /CODEX-P01-T03-VALVE/B1
BUIL false
SHOP false
HPOS E 0mm N 12000mm U 0mm
TPOS E 0mm N 11000mm U 0mm
HDIR S
TDIR N
LHEA true
LTAI true
HBOR 20mm
TBOR 20mm
HCON FBD
TCON TUB
TEMP 50degC
PRES 0pascal
TPRESS 0pascal
HSTU SPCOMPONENT /A3B/PA20
PSPE SPECIFICATION /A3B
DELDSG FALS

NEW GASKET
POS E 0mm N 12000mm U 0mm
ORI Y is E and Z is U
BUIL false
SHOP false
SPRE SPCOMPONENT /A3B/GC20
LSTU SPCOMPONENT /A3B/PA20
ORIF true
POSF true
DELDSG FALS

END
NEW FLANGE
POS E 0mm N 11998.5mm U 0mm
ORI Y is E and Z is U
BUIL false
SHOP true
SPRE SPCOMPONENT /A3B/FS20
LSTU SPCOMPONENT /A3B/PA20
ORIF true
POSF true
DELDSG FALS

END
NEW VALVE /CODEX-P01-V01
POS E 0mm N 11832.48mm U 0mm
ORI Y is E and Z is U
BUIL false
SHOP false
SPRE SPCOMPONENT /A3B/VG20
LSTU SPCOMPONENT /A3B/PA20
ORIF true
POSF true
DELDSG FALS

END
END
END

-- T04: vertical 100-to-80 reducer.
NEW PIPE /CODEX-P01-T04-REDUCER
BUIL false
SHOP false
BORE 100mm
TEMP 50degC
PRES 0pascal
TPRESS 0pascal
PSPE SPECIFICATION /A3B
DELDSG FALS

NEW BRANCH /CODEX-P01-T04-REDUCER/B1
BUIL false
SHOP false
HPOS E 4000mm N 12000mm U 3000mm
TPOS E 4000mm N 12000mm U 0mm
HDIR D
TDIR U
LHEA true
LTAI true
HBOR 100mm
TBOR 80mm
HCON OPEN
TCON OPEN
TEMP 50degC
PRES 0pascal
TPRESS 0pascal
HSTU SPCOMPONENT /A3B/PA100
PSPE SPECIFICATION /A3B
DELDSG FALS

NEW REDUCER
POS E 4000mm N 12000mm U 1500mm
ORI Y is E and Z is U
BUIL false
SHOP true
SPRE SPCOMPONENT /A3B/RC100X80
LSTU SPCOMPONENT /A3B/PA80
ORIF true
POSF true
DELDSG FALS

END
END
END

END
END

INPUT END SITE /CODEX-PIPE-LAB01
INPUT FINISH

LABEL /ERROR3
handle ANY
$S+
RETURN ERROR
endhandle

$S+  -- Synonym translation ON

