$S-  -- Synonym translation OFF
-- PML-STUDY-PIPE-001 / candidate 02
-- Control: native component order POS then ORI.

ONERROR GOLABEL /ERROR3

INPUT BEGIN
NEW SITE /CODEX-PIPE-LAB02
PURP PIPE

NEW ZONE /CODEX-PIPE-LAB02-ZONE
DESC 'PIPE COMPONENT POS THEN ORI'
FUNC 'Piping'
PURP PIPE

NEW PIPE /CODEX-P02-POS-ORI
BORE 100mm
TEMP 50degC
PRES 0pascal
TPRESS 0pascal
PSPE SPECIFICATION /A3B
DELDSG FALS

NEW BRANCH /CODEX-P02-POS-ORI/B1
HPOS E 0mm N 0mm U 0mm
TPOS W 4000mm N 0mm U 2000mm
HDIR U
TDIR E
LHEA true
LTAI true
HBOR 100mm
TBOR 100mm
HCON OPEN
TCON OPEN
HSTU SPCOMPONENT /A3B/PA100
PSPE SPECIFICATION /A3B
DELDSG FALS

NEW ELBOW
POS E 0mm N 0mm U 2000mm
ORI Y is D and Z is N
BUIL false
SHOP true
SPRE SPCOMPONENT /A3B/EA100
LSTU SPCOMPONENT /A3B/PA100
ORIF true
POSF true
DELDSG FALS

END
END
END
END
END

INPUT END SITE /CODEX-PIPE-LAB02
INPUT FINISH

LABEL /ERROR3
handle ANY
$S+
RETURN ERROR
endhandle

$S+  -- Synonym translation ON

