$S-  -- Synonym translation OFF
-- PML-STUDY-PIPE-001 / candidate 08
-- Balanced cluster: straight, slope, verified elbow and verified reducer.
-- This is an intent/evidence mix, not an equal-syntax quota.

ONERROR GOLABEL /ERROR3

INPUT BEGIN
NEW SITE /CODEX-PIPE-LAB08
PURP PIPE

NEW ZONE /CODEX-PIPE-LAB08-ZONE
DESC 'BALANCED PIPE CLUSTER TEST'
FUNC 'Piping'
PURP PIPE

NEW PIPE /CODEX-P08-01-HEADER
BORE 100mm
TEMP 50degC
PRES 0pascal
TPRESS 0pascal
PSPE SPECIFICATION /A3B
NEW BRANCH /CODEX-P08-01-HEADER/B1
HPOS E 0mm N 0mm U 0mm
TPOS E 12000mm N 0mm U 0mm
HDIR E
TDIR W
LHEA true
LTAI true
HBOR 100mm
TBOR 100mm
HCON OPEN
TCON OPEN
TEMP 50degC
PRES 0pascal
TPRESS 0pascal
HSTU SPCOMPONENT /A3B/PA100
PSPE SPECIFICATION /A3B
END
END

NEW PIPE /CODEX-P08-02-SLOPE
BORE 100mm
TEMP 50degC
PRES 0pascal
TPRESS 0pascal
PSPE SPECIFICATION /A1A
SLOREF SLOELE /1in100
NEW BRANCH /CODEX-P08-02-SLOPE/B1
HPOS E 0mm N 2500mm U 100mm
TPOS E 10000mm N 2500mm U 0mm
HDIR E 0.5729 D
TDIR W 0.5729 U
LHEA true
LTAI true
HBOR 100mm
TBOR 100mm
HCON OPEN
TCON OPEN
TEMP 50degC
PRES 0pascal
TPRESS 0pascal
HSTU SPCOMPONENT /A1A/PA100
PSPE SPECIFICATION /A1A
SLOREF SLOELE /1in100
END
END

NEW PIPE /CODEX-P08-03-ELBOW
BORE 100mm
TEMP 50degC
PRES 0pascal
TPRESS 0pascal
PSPE SPECIFICATION /A3B
NEW BRANCH /CODEX-P08-03-ELBOW/B1
HPOS E 0mm N 5000mm U 0mm
TPOS E -4000mm N 5000mm U 2000mm
HDIR U
TDIR E
LHEA true
LTAI true
HBOR 100mm
TBOR 100mm
HCON OPEN
TCON OPEN
TEMP 50degC
PRES 0pascal
TPRESS 0pascal
HSTU SPCOMPONENT /A3B/PA100
PSPE SPECIFICATION /A3B
NEW ELBOW
POS E 0mm N 5000mm U 2000mm
ORI Y IS D AND Z IS N
BUIL false
SHOP true
SPRE SPCOMPONENT /A3B/EA100
LSTU SPCOMPONENT /A3B/PA100
ARRI 2
LEAV 1
ORIF true
POSF true
END
END
END

NEW PIPE /CODEX-P08-04-REDUCER
BORE 100mm
TEMP 50degC
PRES 0pascal
TPRESS 0pascal
PSPE SPECIFICATION /A3B
NEW BRANCH /CODEX-P08-04-REDUCER/B1
HPOS E 4000mm N 7500mm U 3000mm
TPOS E 4000mm N 7500mm U 0mm
HDIR D
TDIR U
LHEA true
LTAI true
HBOR 100mm
TBOR 80mm
HCON OPEN
TCON OPEN
TEMP 50degC
PRES 0pascal
TPRESS 0pascal
HSTU SPCOMPONENT /A3B/PA100
PSPE SPECIFICATION /A3B
NEW REDUCER
POS E 4000mm N 7500mm U 1500mm
ORI Y IS N AND Z IS E
BUIL false
SHOP true
SPRE SPCOMPONENT /A3B/RC100X80
LSTU SPCOMPONENT /A3B/PA80
ORIF true
POSF true
END
END
END

END
END

INPUT END SITE /CODEX-PIPE-LAB08
INPUT FINISH

LABEL /ERROR3
handle ANY
$S+
RETURN ERROR
endhandle

$S+  -- Synonym translation ON
