$S-  -- Synonym translation OFF
-- PML-STUDY-PIPE-001 / candidate 05
-- Straight 100 bore branch falling 100 mm over 10000 mm.

ONERROR GOLABEL /ERROR3

INPUT BEGIN
NEW SITE /CODEX-PIPE-LAB05
PURP PIPE

NEW ZONE /CODEX-PIPE-LAB05-ZONE
DESC 'PIPE SLOPE 1 IN 100 TEST'
FUNC 'Piping'
PURP PIPE

NEW PIPE /CODEX-P05-SLOPE
BORE 100mm
TEMP 50degC
PRES 0pascal
TPRESS 0pascal
PSPE SPECIFICATION /A1A
SLOREF SLOELE /1in100
DELDSG FALS

NEW BRANCH /CODEX-P05-SLOPE/B1
HPOS E 0mm N 0mm U 100mm
TPOS E 10000mm N 0mm U 0mm
HDIR E 0.5729 D
TDIR W 0.5729 U
LHEA true
LTAI true
HBOR 100mm
TBOR 100mm
HCON OPEN
TCON OPEN
HSTU SPCOMPONENT /A1A/PA100
PSPE SPECIFICATION /A1A
SLOREF SLOELE /1in100
DELDSG FALS

END
END
END
END

INPUT END SITE /CODEX-PIPE-LAB05
INPUT FINISH

LABEL /ERROR3
handle ANY
$S+
RETURN ERROR
endhandle

$S+  -- Synonym translation ON

