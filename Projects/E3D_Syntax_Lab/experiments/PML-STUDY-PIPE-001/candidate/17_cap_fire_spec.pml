$S-  -- Synonym translation OFF

ONERROR GOLABEL /ERROR3

INPUT BEGIN
NEW SITE /CODEX-PIPE-LAB17
PURP PIPE

NEW ZONE /CODEX-PIPE-LAB17-ZONE
DESC 'CAP /FIRE SPEC PROBE'
FUNC 'Piping'
PURP PIPE

NEW PIPE /CODEX-QCAP
BUIL false
SHOP false
BORE 100mm
TEMP 50degC
PRES 0pascal
TPRESS 0pascal
PSPE SPECIFICATION /FIRE
DELDSG FALS
NEW BRANCH /CODEX-QCAP/B1
BUIL false
SHOP false
HPOS W 321400mm N 335428mm U 99786mm
TPOS W 305360mm N 335428mm U 103067mm
HDIR U
TDIR W
LHEA true
LTAI true
HBOR 100mm
TBOR 80mm
HCON SCF
TCON CLOS
LNTP unset
TEMP 50degC
PRES 0pascal
TPRESS 0pascal
HSTU SPCOMPONENT /FIRE/TUBE-7
CCEN 0
CCLA 0
PSPE SPECIFICATION /FIRE
DUTY unset
DSCO unset
PTSP unset
INSC unset
PLANU unset
DELDSG FALS

NEW ELBOW
POS W 321400mm N 335428mm U 100500mm
ORI Y is E and Z is N
BUIL false
SHOP false
SPRE SPCOMPONENT /FIRE/ELBO-7
LSTU SPCOMPONENT /FIRE/TUBE-7
ORIF true
POSF true
RLOC 2
DELDSG FALS

END
NEW ELBOW
POS W 320926.04mm N 335428mm U 100500mm
ORI Y is U and Z is S
BUIL false
SHOP false
SPRE SPCOMPONENT /FIRE/ELBO-7
LSTU SPCOMPONENT /FIRE/TUBE-7
ORIF true
POSF true
RLOC 2
DELDSG FALS

END
NEW VALVE
POS W 320926.04mm N 335428mm U 101055.25mm
ORI Y is S and Z is E
BUIL false
SHOP false
SPRE SPCOMPONENT /FIRE/VALV-3
LSTU SPCOMPONENT /FIRE/TUBE-7
ORIF true
POSF true
DELDSG FALS

END
NEW COUPLING
POS W 320926.04mm N 335428mm U 101655mm
ORI Y is N 25 E and Z is W 25 N
BUIL false
SHOP false
SPRE SPCOMPONENT /FIRE/COUP-14
LSTU SPCOMPONENT /FIRE/TUBE-6
ORIF true
POSF true
DELDSG FALS

END
NEW ELBOW
POS W 320926.04mm N 335428mm U 103067mm
ORI Y is D and Z is S
BUIL false
SHOP false
SPRE SPCOMPONENT /FIRE/ELBO-6
LSTU SPCOMPONENT /FIRE/TUBE-6
ARRI 2
LEAV 1
ORIF true
POSF true
DELDSG FALS

END
NEW CAP
POS W 305360mm N 335428mm U 103067mm
BUIL false
SHOP false
SPRE SPCOMPONENT /FIRE/CAP-6
LSTU SPCOMPONENT /FIRE/TUBE-6
ORIF true
POSF true
DELDSG FALS

END
END
END

END
END

INPUT END SITE /CODEX-PIPE-LAB17
INPUT FINISH

LABEL /ERROR3
handle ANY
$S+
RETURN ERROR
endhandle

$S+  -- Synonym translation ON
