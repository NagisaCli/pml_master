$S-  -- Synonym translation OFF
-- PML-STUDY-PIPE-001 / candidate 07
-- Round-2 repair: native vertical reducer axes Y=N, Z=E.

ONERROR GOLABEL /ERROR3

INPUT BEGIN
NEW SITE /CODEX-PIPE-LAB07
PURP PIPE

NEW ZONE /CODEX-PIPE-LAB07-ZONE
DESC 'VERTICAL REDUCER NATIVE AXES TEST'
FUNC 'Piping'
PURP PIPE

NEW PIPE /CODEX-P07-REDU-VERTICAL
BORE 100mm
TEMP 50degC
PRES 0pascal
TPRESS 0pascal
PSPE SPECIFICATION /A3B
DELDSG FALS

NEW BRANCH /CODEX-P07-REDU-VERTICAL/B1
HPOS E 0mm N 0mm U 3000mm
TPOS E 0mm N 0mm U 0mm
HDIR D
TDIR U
LHEA true
LTAI true
HBOR 100mm
TBOR 80mm
HCON OPEN
TCON OPEN
HSTU SPCOMPONENT /A3B/PA100
PSPE SPECIFICATION /A3B
DELDSG FALS

NEW REDUCER
POS E 0mm N 0mm U 1500mm
ORI Y is N and Z is E
BUIL false
SHOP true
SPRE SPCOMPONENT /A3B/RC100X80
LSTU SPCOMPONENT /A3B/PA80
ORIF true
POSF true
DELDSG FALS

END
END
END
END
END

INPUT END SITE /CODEX-PIPE-LAB07
INPUT FINISH

LABEL /ERROR3
handle ANY
$S+
RETURN ERROR
endhandle

$S+  -- Synonym translation ON

