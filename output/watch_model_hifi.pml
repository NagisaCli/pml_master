-- =================================================================
-- E3D Agent high-fidelity diver-style wristwatch, 41 mm reference
-- Units: mm. Select an existing writable ZONE as CE before running.
-- Coordinate system: +N = 12 o'clock, +E = crown side, +U = crystal.
-- Data and spatial calculations: watch_model_hifi_parameters.md
-- This macro does not create SITE or ZONE.
-- =================================================================

-- ===== Coaxial case stack; total external height = 11.25 mm =====
NEW EQUI /WATCHHF_BACK_001
DESC 'Screw case back, diameter 39.0 mm'
POS E 0 N 0 U -1.20
NEW CYLI
DIAM 39.0
HEIG 1.20

NEW EQUI /WATCHHF_MIDCASE_001
DESC 'Monobloc middle case, diameter 41.0 mm'
POS E 0 N 0 U 0
NEW CYLI
DIAM 41.0
HEIG 7.20

NEW EQUI /WATCHHF_BEZEL_001
DESC 'Unidirectional rotating bezel, outer diameter 41.8 mm'
POS E 0 N 0 U 7.20
NEW CYLI
DIAM 41.8
HEIG 1.15

NEW EQUI /WATCHHF_BEZEL_INSERT_001
DESC 'Ceramic bezel insert, diameter 38.7 mm'
POS E 0 N 0 U 8.35
NEW CYLI
DIAM 38.7
HEIG 0.25

NEW EQUI /WATCHHF_REHAUT_001
DESC 'Inner chapter ring, diameter 36.3 mm'
POS E 0 N 0 U 8.60
NEW CYLI
DIAM 36.3
HEIG 0.10

NEW EQUI /WATCHHF_DIAL_001
DESC 'Dial blank, diameter 34.6 mm'
POS E 0 N 0 U 8.70
NEW CYLI
DIAM 34.6
HEIG 0.15

NEW EQUI /WATCHHF_CRYSTAL_001
DESC 'Sapphire crystal, diameter 35.5 mm'
POS E 0 N 0 U 9.40
NEW CYLI
DIAM 35.5
HEIG 0.65

-- Hide WATCHHF_CRYSTAL_001 temporarily when inspecting dial details.

-- ===== Crown assembly; axis is aligned with +E =====
NEW EQUI /WATCHHF_CROWN_TUBE_001
DESC 'Crown tube with 0.50 mm overlap into middle case'
POS E 19.50 N 0 U 3.60
ORI Y IS N AND Z IS E
NEW CYLI
DIAM 7.30
HEIG 1.20

NEW EQUI /WATCHHF_CROWN_001
DESC 'Screw-down crown, 6.50 mm diameter'
POS E 20.00 N 0 U 3.60
ORI Y IS N AND Z IS E
NEW CYLI
DIAM 6.50
HEIG 4.20

NEW EQUI /WATCHHF_CROWN_GUARD_N_001
DESC 'Upper crown guard'
POS E 19.80 N 5.40 U 3.10
NEW BOX
XLEN 4.40
YLEN 3.20
ZLEN 5.20

NEW EQUI /WATCHHF_CROWN_GUARD_S_001
DESC 'Lower crown guard'
POS E 19.80 N -5.40 U 3.10
NEW BOX
XLEN 4.40
YLEN 3.20
ZLEN 5.20

-- ===== Four lugs; Y extrema are +/-24.40, exactly 48.80 mm =====
